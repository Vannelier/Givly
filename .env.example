# --- Base de donnees ---------------------------------------------------------
# Pilote `pg` standard : n'importe quel Postgres convient (Railway, Neon,
# Supabase, local). La chaine doit inclure l'utilisateur, le mot de passe,
# l'hote, le port et la base.
POSTGRES_URL=

# Connexion directe, utilisee par `npm run db:migrate`. Chez la plupart des
# hebergeurs, c'est la meme valeur que ci-dessus.
POSTGRES_URL_NON_POOLING=

# --- Stockage des images -----------------------------------------------------
# Vercel Blob. Absent, l'application ecrit dans un dossier `.media/` local :
# pratique en developpement, mais ephemere sur un hebergeur sans volume
# persistant — les images disparaitraient au redeploiement.
BLOB_READ_WRITE_TOKEN=

# --- Application -------------------------------------------------------------
# Base absolue des liens publics, des liens d'administration, des QR codes, des
# balises Open Graph, de robots.txt et du sitemap. DOIT etre definie des la phase
# de build : le prefixe NEXT_PUBLIC_ fait que Next inline la valeur a ce
# moment-la, et l'accueil, statique, y fige l'adresse de sa banniere.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Duree de vie d'une page gratuite, en jours.
FREE_PAGE_TTL_DAYS=30

# Coupe la limitation de debit. UNIQUEMENT en developpement : sans proxy devant
# l'application, toutes les requetes locales partagent un seul compteur, et dix
# creations d'affilee suffisent a se bloquer soi-meme. Ne jamais poser en
# production, ce serait rouvrir les routes anonymes en grand.
# RATE_LIMIT_DISABLED=1
